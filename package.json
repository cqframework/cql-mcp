{
  "name": "@cqframework/cql-mcp",
  "version": "0.1.0",
  "description": "Standalone MCP server for HL7 CQL: execution, ELM inspection, DAP step-through debugging, and headless test runs against the cql-language-server JVM",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cqframework/cql-mcp.git"
  },
  "homepage": "https://github.com/cqframework/cql-mcp#readme",
  "bugs": {
    "url": "https://github.com/cqframework/cql-mcp/issues"
  },
  "keywords": [
    "cql",
    "clinical-quality-language",
    "mcp",
    "model-context-protocol",
    "fhir",
    "dap",
    "debugger"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "dist/src/index.js",
  "bin": {
    "cql-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "scripts/smoke.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.json",
    "test": "npm run pretest && mocha \"dist/test/unit/**/*.test.js\" \"dist/test/integration/**/*.test.js\" --timeout 180000",
    "test:unit": "npm run pretest && mocha \"dist/test/unit/**/*.test.js\" --timeout 15000",
    "test:net": "npm run pretest && mocha \"dist/test/net/**/*.test.js\" --timeout 30000",
    "test:integration": "npm run pretest && mocha \"dist/test/integration/**/*.test.js\" --timeout 180000",
    "smoke": "bash scripts/smoke.sh \"$PWD\" \"$PWD\" \"${CQL_LS_JAR_PATH:?CQL_LS_JAR_PATH must be set}\"",
    "prepack": "npm run compile",
    "test:e2e": "npm run compile && node test/e2e/restricted-network/orchestrate.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@vscode/debugprotocol": "1.68.0",
    "fast-xml-parser": "5.12.0",
    "jsonc-parser": "3.3.1",
    "undici": "7.30.2",
    "vscode-jsonrpc": "9.0.2",
    "vscode-languageserver-protocol": "3.18.3",
    "vscode-uri": "3.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.2",
    "chai": "4.5.0",
    "mocha": "12.0.3",
    "source-map-support": "0.5.21",
    "typescript": "5.9.3"
  }
}
